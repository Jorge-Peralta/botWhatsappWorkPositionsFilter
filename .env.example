# Absolute or relative paths (relative resolved against project root)
SESSION_DIR=./data/auth
IMAGES_DIR=./data/images

# Comma-separated list of WhatsApp group JIDs to capture images from.
# Discover JIDs by running the bot once and reading the "participating groups" log.
# Example: 1203630...@g.us,1203699...@g.us
TARGET_GROUP_JIDS=

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Set to true to authenticate via pairing code instead of QR scan.
USE_PAIRING_CODE=false
# Required when USE_PAIRING_CODE=true. Include country code, digits only.
PAIRING_PHONE_NUMBER=

ANTHROPIC_API_KEY=

EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
